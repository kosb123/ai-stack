STORAGE_ENCRYPTION_KEY=${LOCAL_SECRET}

# --- multi-agent admission tuning ---
# Originally set for the OpenClaw fleet (removed 2026-10-22). Kept for Hermes' parallel agents:
# no admission rejections were logged with these values. Defaults: count cap unset,
# QUEUE_MS=2000, MAX_QUEUED_BYTES=4194304 (docs/reference/ENVIRONMENT.md).
OMNIROUTE_CHAT_MAX_HEAVY_IN_FLIGHT=6
OMNIROUTE_CHAT_ADMISSION_HEALTHY_HEADROOM=4
OMNIROUTE_CHAT_ADMISSION_QUEUE_MS=60000
OMNIROUTE_CHAT_ADMISSION_MAX_QUEUED_BYTES=33554432

# --- network exposure (2026-10-23) ---
# Listen on loopback only: every client (Hermes, omni-autotune) uses 127.0.0.1, and the
# default 0.0.0.0 exposed the proxy to the LAN (docs/security/INFERENCE_AUTH_POSTURE.md).
OMNIROUTE_SERVER_HOST=127.0.0.1
# Require a valid API key on /v1 inference; this file wins over the package .env (false).
REQUIRE_API_KEY=true
# Copied from the package .env so npm updates keep the same machine id (OmniRoute CLI warning)
MACHINE_ID_SALT=${LOCAL_SECRET}

# --- slow first token (2026-10-29) ---
# User pinned antigravity/gemini-3.8-flash-medium as #1 and asked that slow answers not become errors. At the
# default 80 s (adaptive cap 180 s) OmniRoute dropped slow gemini-3.8 streams ("produced no readiness event -
# retrying once on a fresh upstream request", 2026-10-28). Hermes waits 360 s (stale_timeout_seconds).
# docs/reference/ENVIRONMENT.md: STREAM_READINESS_TIMEOUT_MS default 80000, STREAM_READINESS_MAX_TIMEOUT_MS default 180000
STREAM_READINESS_TIMEOUT_MS=180000
STREAM_READINESS_MAX_TIMEOUT_MS=300000
