# Hindsight server env (docker run --env-file). LLM = OmniRoute hermes-fast-agent, failover FreeLLMAPI auto:hermes (2026-10-24; was local llama.cpp Qwen).
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:20128/v1
HINDSIGHT_API_LLM_API_KEY=${LOCAL_SECRET}
HINDSIGHT_API_LLM_MODEL=hindsight-structured
HINDSIGHT_API_LLM_1_PROVIDER=openai
HINDSIGHT_API_LLM_1_BASE_URL=http://host.docker.internal:3001/v1
HINDSIGHT_API_LLM_1_API_KEY=${LOCAL_SECRET}
HINDSIGHT_API_LLM_1_MODEL=auto:hermes
HINDSIGHT_API_LLM_STRATEGY={"mode": "failover", "cooldown_seconds": 300}
# 2026-10-26 cloud chain: 6 parallel calls (2 for the old local llama-server, 4 on 10-24), so 3 refresh slots still leave 3 for retain/consolidation
HINDSIGHT_API_LLM_MAX_CONCURRENT=6
HINDSIGHT_API_LLM_TIMEOUT=300
# 2026-10-24: must exceed the largest retain_chunk_size (conversation strategy = 12000) or retains are rejected; 32000 was sized for the local 98k window
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=16384
HINDSIGHT_API_REFLECT_LLM_TIMEOUT=300
# Multilingual (Korean) retrieval: default bge-small-en / ms-marco are English-only (hindsight#1569, #5519)
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-m3
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Whole reflect / page refresh ceiling, counted from task start INCLUDING time queued for an LLM slot. 2026-10-25 16:30 KST:
# after a quiet morning every page whose cron had passed fired at once when new memories arrived (9 pages), queued behind
# the single refresh slot and all hit the 900 s limit, pausing auto refresh. 1800 s + 3 refresh slots absorb such a burst (#3002).
HINDSIGHT_API_REFLECT_WALL_TIMEOUT=1800
# Combo members are mixed free models that can drift out of Korean; force Korean for retain facts, observations and reflect
HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=Korean
# Fixed worker id: on restart the worker only recovers tasks it claimed itself; a random hostname orphans in-flight tasks
HINDSIGHT_API_WORKER_ID=hindsight-main
# Page refreshes use at most 3 of the 6 LLM slots (1 was a local-Qwen limit and caused the 10-25 burst failure)
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_MAX_CONCURRENT=3
# Reflect below the 0.9 default to keep mixed free models on-language and on-fact. Page-refresh edits use the
# consolidation default (0.0): the docs reserve a separate refresh temperature for a refresh running its own model.
HINDSIGHT_API_LLM_TEMPERATURE_REFLECT=0.6

# Recall reranker: length-sorted bucket batching (official opt-in, 36-54% faster, identical results; hindsight#587). Added 2026-10-22.
HINDSIGHT_API_RERANKER_LOCAL_BUCKET_BATCHING=true
# Official tuning (developer/performance + configuration docs), added 2026-10-22:
# reranker cap: docs call 100 the biggest single CPU win (default 300)
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=100
# reflect context: docs say lower it below 128K-window models; combo members are mixed free models, so stay at 60k (default 100000)
HINDSIGHT_API_REFLECT_MAX_CONTEXT_TOKENS=60000
# Docs "Retries inside a chain": fail over at once from the primary (the OmniRoute combo already falls through its own
# members), and give the last member (FreeLLMAPI) the retry budget, since it has nowhere left to fail over to.
# 2026-10-27 22:50 user: revert to official defaults (LLM_TIMEOUT 120, REFLECT_LLM_TIMEOUT 30, REFLECT_WALL_TIMEOUT 300, LLM_MAX_RETRIES 3, member inherits) - was: HINDSIGHT_API_LLM_MAX_RETRIES=0
# 2026-10-27 22:50 user: revert to official defaults (LLM_TIMEOUT 120, REFLECT_LLM_TIMEOUT 30, REFLECT_WALL_TIMEOUT 300, LLM_MAX_RETRIES 3, member inherits) - was: HINDSIGHT_API_LLM_1_MAX_RETRIES=2
# 2026-10-24: grammar-enforced json_schema (strict) instead of schema-in-prompt + json_object, so a free combo member that
# answers with prose or ```json fences cannot wedge retain/consolidation. Both routes verified to honour strict schemas.
HINDSIGHT_API_LLM_STRICT_SCHEMA=true
# delete finished operation rows after 30 days; memories are not affected (default 0 = keep forever)
HINDSIGHT_API_OPERATION_RETENTION_DAYS=30

# 2026-10-28: OmniRoute injects memory_* tools into requests unless this header is sent; the model then calls memory_save instead of returning JSON -> empty content -> fallback (12x on 2026-10-28)
# 2026-10-31: consolidation sends temperature 0, which OmniRoute's semantic cache stores (src/lib/semanticCache.ts); a
# truncated JSON reply was served back from cache on all 3 retries (2026-10-30 13:24 UTC), so no retry reached the model
HINDSIGHT_API_LLM_DEFAULT_HEADERS={"x-omniroute-no-memory":"true","x-omniroute-no-cache":"true"}
# 2026-10-29: medium (pinned #1) needs 120-300 s for an 8-fact consolidation batch; per-op timeout (Hindsight config.py) below OmniRoute FETCH_TIMEOUT_MS 600 s
HINDSIGHT_API_CONSOLIDATION_LLM_TIMEOUT=540

# 2026-10-30 user (pstack review): 83% of Hindsight output tokens were thinking (2.71M of 3.28M in 24 h) although no effort
# was sent; OmniRoute maps reasoning_effort=low to Gemini thinkingBudget 1024. Docs (developer/performance): reasoning on
# the extract/merge path is pure latency. Reflect / page refresh keep the model default.
# 2026-10-31 user: all reasoning low. The global value is inherited by every operation and by the LLM_<n> fallback
# members (docs developer/configuration); FreeLLMAPI auto:hermes answered 200 with reasoning_effort=low.
HINDSIGHT_API_LLM_REASONING_EFFORT=low
HINDSIGHT_API_RETAIN_LLM_REASONING_EFFORT=low
HINDSIGHT_API_CONSOLIDATION_LLM_REASONING_EFFORT=low
# 2026-10-30 user: page refresh (largest consumer, ~5.7M input tokens/day) gets its own omni-autotune lane with
# agy/gemini-3-flash first; the global failover member (FreeLLMAPI) is still inherited (memory_engine chain fallback).
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_MODEL=hindsight-refresh
