HINDSIGHT_API_LLM_1_API_KEY=${LOCAL_SECRET}
HINDSIGHT_API_LLM_1_MODEL=auto:hermes
HINDSIGHT_API_LLM_STRATEGY={"mode": "failover", "cooldown_seconds": 300}
HINDSIGHT_API_LLM_MAX_CONCURRENT=6
HINDSIGHT_API_LLM_TIMEOUT=300
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=16384
HINDSIGHT_API_REFLECT_LLM_TIMEOUT=300
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-m3
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
HINDSIGHT_API_REFLECT_WALL_TIMEOUT=1800
HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=Korean
HINDSIGHT_API_WORKER_ID=hindsight-main
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_MAX_CONCURRENT=3
HINDSIGHT_API_LLM_TEMPERATURE_REFLECT=0.6
HINDSIGHT_API_RERANKER_LOCAL_BUCKET_BATCHING=true
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=100
HINDSIGHT_API_REFLECT_MAX_CONTEXT_TOKENS=60000
HINDSIGHT_API_LLM_STRICT_SCHEMA=true
HINDSIGHT_API_OPERATION_RETENTION_DAYS=30
HINDSIGHT_API_LLM_DEFAULT_HEADERS={"x-omniroute-no-memory":"true","x-omniroute-no-cache":"true"}
