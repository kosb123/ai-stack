+def _selection_provider(agent):
+    """Keep the route identity when a client reuses this snapshot for a new chat."""
+    provider = getattr(agent, "provider", "") or ""
+    if provider != "custom":
+        return provider
+    requested = getattr(agent, "requested_provider", "") or ""
+    if requested and requested not in {"custom", "auto"} and not getattr(agent, "_voice_route_state", None):
+        return requested
+    from hermes_cli.runtime_provider import canonical_custom_identity
+    return canonical_custom_identity(base_url=getattr(agent, "base_url", None),
+                                     model=getattr(agent, "model", None)) or provider
+
+
